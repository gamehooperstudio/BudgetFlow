<Window x:Class="BudgetFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:BudgetFlow.Views" WindowStyle="None" Title="BudgetFlow" Width="1440" Height="860" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Language="fr-FR" FontFamily="Segoe UI" Foreground="#142039" Background="#F6F8FC">
<WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
</WindowChrome.WindowChrome>
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/Shared.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#263247"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E4EAF3"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#145BEE"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


<Style TargetType="RadioButton" x:Key="Nav"><Setter Property="Foreground" Value="#DCE5F3"/><Setter Property="Margin" Value="10,4"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" CornerRadius="7" Padding="16,14" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#24344C"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1459D4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A8C8FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>


</ResourceDictionary></Window.Resources>
<Grid x:Name="MainWindowContent"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.RowSpan="2" Background="#111E32"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Margin="18,0,12,24"><Border Background="#4938F5" CornerRadius="12" Width="24" Height="24"><TextBlock Text="BF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="BudgetFlow" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="#CCD6E5" FontSize="12" Margin="28,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="24,20"><TextBlock Text="DÉMONSTRATION" FontSize="10" Foreground="#94A5BE"/><TextBlock Text="© 2026 BudgetFlow" FontSize="11" Foreground="#94A5BE" Margin="0,8,0,0"/></StackPanel><StackPanel><RadioButton x:Name="DashboardNav" Style="{StaticResource Nav}" GroupName="Page" IsChecked="True" Content="▦    Tableau de bord"/><RadioButton x:Name="TransactionsNav" Style="{StaticResource Nav}" GroupName="Page" Content="⇄    Transactions"/><TextBlock Text="BUDGET" Foreground="#8596AF" FontSize="10" Margin="26,30,0,14"/><RadioButton x:Name="IncomeNav" Style="{StaticResource Nav}" GroupName="Page" Content="↗    Revenus"/><RadioButton x:Name="ExpenseNav" Style="{StaticResource Nav}" GroupName="Page" Content="↘    Dépenses"/><TextBlock Text="Catégories" Foreground="#8596AF" Margin="26,12"/><TextBlock Text="Statistiques" Foreground="#8596AF" Margin="26,12"/><TextBlock Text="Rapports" Foreground="#8596AF" Margin="26,12"/><TextBlock Text="Paramètres" Foreground="#8596AF" Margin="26,12"/></StackPanel></DockPanel></Border>
<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0">
    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Réduire" AutomationProperties.Name="Réduire" Click="Minimize_Click"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Agrandir / Restaurer" AutomationProperties.Name="Agrandir ou restaurer" Click="Maximize_Click"/>
    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Fermer" AutomationProperties.Name="Fermer" Click="Close_Click"/>
</StackPanel>
<ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,28,16,14">
<DockPanel Margin="0,0,12,24"><Border DockPanel.Dock="Right" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="6" Padding="14,9"><TextBlock Text="Toutes les dates · Démonstration" FontSize="12"/></Border><StackPanel><TextBlock FontSize="23" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Tableau de bord"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TransactionsNav}" Value="True"><Setter Property="Text" Value="Transactions"/></DataTrigger><DataTrigger Binding="{Binding IsChecked, ElementName=IncomeNav}" Value="True"><Setter Property="Text" Value="Revenus"/></DataTrigger><DataTrigger Binding="{Binding IsChecked, ElementName=ExpenseNav}" Value="True"><Setter Property="Text" Value="Dépenses"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Vos finances, en un coup d’œil · Données de démonstration" Foreground="#748095" Margin="0,6,0,0" FontSize="12"/></StackPanel></DockPanel>
<views:IncomeView DataContext="{Binding Income}"><views:IncomeView.Style><Style TargetType="views:IncomeView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=IncomeNav}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:IncomeView.Style></views:IncomeView>
<views:ExpenseView DataContext="{Binding Expense}"><views:ExpenseView.Style><Style TargetType="views:ExpenseView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ExpenseNav}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:ExpenseView.Style></views:ExpenseView>
<StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=IncomeNav}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsChecked, ElementName=ExpenseNav}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<UniformGrid Columns="4">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Revenus totaux" Foreground="#008C68"/><TextBlock Text="{Binding TotalIncome}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="↗ Entrées enregistrées" Foreground="#008C68" FontSize="11"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dépenses totales"/><TextBlock Text="{Binding TotalExpenses}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="↗ Sorties enregistrées" Foreground="#E44860" FontSize="11"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Solde" Foreground="#145BEE"/><TextBlock Text="{Binding Balance}" Foreground="#145BEE" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Revenus − dépenses" Foreground="#748095" FontSize="11"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Transactions"/><TextBlock Text="{Binding Transactions.Count}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Toutes les dates" Foreground="#748095" FontSize="11"/></StackPanel></Border>
</UniformGrid>
<Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TransactionsNav}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Évolution du solde" Style="{StaticResource Heading}"/><TextBlock Text="Illustration du graphique à venir" Foreground="#748095" FontSize="11" Margin="0,-10,0,12"/><Viewbox Stretch="Uniform"><Canvas Width="520" Height="200"><Path Stroke="#EDF1F7" Data="M 36,20 H 510 M 36,65 H 510 M 36,110 H 510 M 36,155 H 510"/><TextBlock Canvas.Top="13" Text="2 K" FontSize="10"/><TextBlock Canvas.Top="103" Text="1 K" FontSize="10"/><TextBlock Canvas.Top="148" Text="0" FontSize="10"/><Path Data="M 36,145 L 65,132 83,136 110,111 132,100 151,116 180,109 204,88 224,67 244,71 262,65 287,82 312,60 335,68 358,39 375,28 399,43 421,39 445,47 472,32 493,38 510,27 L 510,155 36,155 Z"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CEE0FF" Offset="0"/><GradientStop Color="#FAFCFF" Offset="1"/></LinearGradientBrush></Path.Fill></Path><Polyline Stroke="#1764FF" StrokeThickness="2" Points="36,145 65,132 83,136 110,111 132,100 151,116 180,109 204,88 224,67 244,71 262,65 287,82 312,60 335,68 358,39 375,28 399,43 421,39 445,47 472,32 493,38 510,27"/><TextBlock Canvas.Left="36" Canvas.Top="175" Text="1 mai" FontSize="10"/><TextBlock Canvas.Left="155" Canvas.Top="175" Text="8 mai" FontSize="10"/><TextBlock Canvas.Left="270" Canvas.Top="175" Text="15 mai" FontSize="10"/><TextBlock Canvas.Left="385" Canvas.Top="175" Text="22 mai" FontSize="10"/><TextBlock Canvas.Left="475" Canvas.Top="175" Text="31 mai" FontSize="10"/></Canvas></Viewbox></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Répartition des dépenses" Style="{StaticResource Heading}"/><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="158" Height="158"><Ellipse Stroke="#1764FF" StrokeThickness="24"/><Path Stroke="#18A888" StrokeThickness="24" Data="M 23,123 A 67,67 0 0 1 39,25"/><Path Stroke="#FF9C32" StrokeThickness="24" Data="M 79,146 A 67,67 0 0 1 23,123"/><Path Stroke="#ED4560" StrokeThickness="24" Data="M 130,123 A 67,67 0 0 1 79,146"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding TotalExpenses}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Total dépenses" FontSize="10" Foreground="#748095" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="●  Logement" Foreground="#1764FF" Margin="0,8"/><TextBlock Text="●  Alimentation" Foreground="#159E83" Margin="0,8"/><TextBlock Text="●  Transport" Foreground="#EA8A24" Margin="0,8"/><TextBlock Text="●  Autres" Foreground="#D93F5C" Margin="0,8"/></StackPanel></Grid><TextBlock Text="Illustration · répartition à relier aux transactions" Foreground="#748095" FontSize="10"/></StackPanel></Border>
</Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Transactions enregistrées" Style="{StaticResource Heading}"/><DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EFF2F7" BorderThickness="0" Background="White" RowHeight="40" FontSize="12" MinHeight="260"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="95"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="75"/><DataGridTextColumn Header="Montant" SortMemberPath="Amount" Binding="{Binding DisplayAmount}" Width="105"/></DataGrid.Columns></DataGrid></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Résumé global" Style="{StaticResource Heading}"/><Separator/><TextBlock Text="Revenus" Foreground="#748095" Margin="0,20,0,7"/><TextBlock Text="{Binding TotalIncome}" Foreground="#008C68" FontSize="20"/><TextBlock Text="Dépenses" Foreground="#748095" Margin="0,20,0,7"/><TextBlock Text="{Binding TotalExpenses}" Foreground="#E44860" FontSize="20"/><Separator Margin="0,20,0,15"/><TextBlock Text="Solde disponible" Foreground="#145BEE"/><TextBlock Text="{Binding Balance}" Foreground="#145BEE" FontWeight="SemiBold" FontSize="24" Margin="0,7,0,0"/></StackPanel></Border></Grid>
</StackPanel></StackPanel></ScrollViewer></Grid></Window>






