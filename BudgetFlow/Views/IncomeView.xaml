<UserControl x:Class="BudgetFlow.Views.IncomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/Shared.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,16"/><Setter Property="BorderBrush" Value="#DCE3EF"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#1459D4"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
</ResourceDictionary></UserControl.Resources>
<StackPanel>
<UniformGrid Columns="3">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Revenus totaux" Foreground="#008C68"/><TextBlock Text="{Binding Total}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Toutes les dates" Foreground="#748095"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Revenus enregistrés"/><TextBlock Text="{Binding Incomes.Count}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Montant moyen"/><TextBlock Text="{Binding Average}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,8"/></StackPanel></Border>
</UniformGrid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="Historique des revenus" Style="{StaticResource Heading}"/>
<TextBlock Text="Sélectionnez un revenu pour le modifier." Foreground="#748095" Margin="0,0,0,16"/>
<DataGrid ItemsSource="{Binding Incomes}" SelectedItem="{Binding SelectedIncome}" SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EFF2F7" BorderThickness="0" Background="White" RowHeight="40" FontSize="12" MinHeight="260" MaxHeight="420">
<DataGrid.Columns>
<DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="90"/>
<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
<DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="90"/>
<DataGridTextColumn Header="Montant" SortMemberPath="Amount" Binding="{Binding DisplayAmount}" Width="100"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="Aucun revenu enregistré." Foreground="#748095" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Incomes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="{Binding FormTitle}" Style="{StaticResource Heading}"/>
<TextBlock Text="Date"/><DatePicker x:Name="IncomeDatePicker" Text="{Binding DateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DateValidationError="DatePicker_DateValidationError" AutomationProperties.Name="Date du revenu" Margin="0,6,0,16"/>
<TextBlock Text="Description"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Description du revenu"/>
<TextBlock Text="Catégorie"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Padding="8" Margin="0,6,0,16" AutomationProperties.Name="Catégorie du revenu"/>
<TextBlock Text="Montant (€)"/><TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Montant du revenu"/>
<WrapPanel><Button Content="Enregistrer" Command="{Binding SaveCommand}"/><Button Content="Nouveau" Command="{Binding NewCommand}" Background="#EAF0FB" Foreground="#145BEE"/></WrapPanel>
<Button Content="Supprimer le revenu" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" Background="#FFF0F2" Foreground="#BD2943" HorizontalAlignment="Left" Margin="0,12,0,0"/>
<TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#145BEE" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="Démonstration : modifications conservées uniquement pendant cette session." TextWrapping="Wrap" Foreground="#748095" FontSize="11" Margin="0,16,0,0"/>
</StackPanel></Border></Grid></StackPanel></UserControl>




